# ─────────────────────────────────────────────────────────────────────────────
# LevelUp mobile — environment variables
# Copy to `.env` or `.env.local` (git-ignored). Restart `expo start` after changes.
# EXPO_PUBLIC_* values are compiled into the app bundle — never put secrets here.
# Every variable is optional: without Supabase the app runs with empty states.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase dashboard → Project Settings → API (same project as the web app).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Allows "Preview with sample data" on the dashboard (always clearly labelled).
# Unset: enabled in development builds, disabled in release builds.
EXPO_PUBLIC_ENABLE_DEMO_DATA=
