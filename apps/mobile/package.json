{
  "name": "@levelup/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "export:android": "expo export --platform android --output-dir dist/android",
    "setup:android": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-android-toolchain.ps1",
    "build:apk": "node scripts/build-apk.mjs",
    "doctor": "expo-doctor"
  },
  "expo": {
    "autolinking": {
      "exclude": [
        "react-native-reanimated",
        "react-native-worklets",
        "react-native-gesture-handler"
      ]
    }
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/manrope": "^0.4.3",
    "@expo/metro-runtime": "~58.0.17",
    "@levelup/supabase": "workspace:*",
    "@levelup/tokens": "workspace:*",
    "@levelup/types": "workspace:*",
    "@levelup/utils": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.119.0",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "lucide-react-native": "^1.71.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@levelup/eslint-config": "workspace:*",
    "@levelup/typescript-config": "workspace:*",
    "@types/react": "^19.3.0",
    "eslint": "^9.39.5",
    "typescript": "~6.0.3"
  }
}
