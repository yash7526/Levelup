# ─────────────────────────────────────────────────────────────────────────────
# LevelUp web — environment variables
# Copy to `.env.local` (git-ignored) and fill in values. Restart `pnpm dev` after changes.
# Every variable is optional: without Supabase the app runs with empty states.
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the site. Used for absolute URLs in metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ─────────────────────────────────────────────────────────────────
# Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (`sb_publishable_…`). Safe for the browser; data is protected by RLS.
# Legacy projects can use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret key. NEVER prefix with NEXT_PUBLIC_. Not used yet; reserved for
# privileged server tasks (webhooks, admin jobs).
# SUPABASE_SECRET_KEY=

# ── Sample data preview ──────────────────────────────────────────────────────
# Allows "Preview sample data" on the dashboard (always clearly labelled).
# Unset: enabled in development, disabled in production. Set to `true` or `false` to override.
NEXT_PUBLIC_ENABLE_DEMO_DATA=
